/* CONFLUX dark — Qt Widgets starter theme. For Qt Quick bind tokens explicitly. */
QWidget { background: #111317; color: #F5F4F0; font-family: "Barlow"; font-size: 14px; }
QFrame[panel="true"], QMenu { background: #1A1D22; border: 1px solid #78808A; border-radius: 12px; }
QPushButton { background: #1A1D22; border: 1px solid #78808A; border-radius: 6px; padding: 8px 16px; min-height: 20px; }
QPushButton:hover { border-color: #FF877D; }
QPushButton:focus, QLineEdit:focus { border: 2px solid #FF877D; }
QPushButton[primary="true"] { background: #FF5B50; color: #111317; border-color: #FF5B50; }
QPushButton:disabled { color: #B5B7BE; background: #24282F; }
QLineEdit, QComboBox, QListView { background: #1A1D22; border: 1px solid #78808A; border-radius: 6px; padding: 8px; selection-background-color: #FF5B50; selection-color: #111317; }
QLabel[muted="true"] { color: #B5B7BE; }
QSlider::groove:horizontal { height: 4px; background: #78808A; border-radius: 2px; }
QSlider::handle:horizontal { width: 16px; margin: -6px 0; background: #F5F4F0; border-radius: 8px; }
QProgressBar { border: 1px solid #78808A; border-radius: 4px; text-align: center; }
QProgressBar::chunk { background: #FF877D; }
QToolTip { background: #1A1D22; color: #F5F4F0; border: 1px solid #78808A; padding: 6px; }
