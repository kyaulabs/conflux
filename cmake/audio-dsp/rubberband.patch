+#ifdef RUBBERBAND_AVX2_PEAKS
+    bool findVectorPeaks(const double *v, std::greater<double>, int start, int end,
+                         int radius, int &numPeaks)
+    {
+        if (end - start < 16 || !__builtin_cpu_supports("avx2")) return false;
+        switch (radius) {
+        case 1: numPeaks = scan<1>(v, start, end); return true;
+        case 2: numPeaks = scan<2>(v, start, end); return true;
+        case 3: numPeaks = scan<3>(v, start, end); return true;
+        case 4: numPeaks = scan<4>(v, start, end); return true;
+        default: return false;
+        }
+    }
+
+    template <int Radius>
+    __attribute__((target("avx2")))
+    int scan(const double *v, int start, int end)
+    {
+        int found = 0;
+        const auto atEdge = [&](int i) {
+            for (int k = std::max(start, i - Radius); k < i; ++k) {
+                if (!(v[i] > v[k])) return;
+            }
+            for (int k = i + 1; k <= std::min(end - 1, i + Radius); ++k) {
+                if (v[k] > v[i]) return;
+            }
+            m_locations[found++] = i;
+        };
+        int i = start;
+        for (; i < start + Radius; ++i) atEdge(i);
+        for (; i <= end - Radius - 4; i += 4) {
+            const auto center = _mm256_loadu_pd(v + i);
+            auto matches = _mm256_castsi256_pd(_mm256_set1_epi64x(-1));
+            for (int offset = 1; offset <= Radius; ++offset) {
+                const auto left = _mm256_loadu_pd(v + i - offset);
+                const auto right = _mm256_loadu_pd(v + i + offset);
+                matches = _mm256_and_pd(matches, _mm256_cmp_pd(center, left, _CMP_GT_OQ));
+                matches = _mm256_and_pd(matches, _mm256_cmp_pd(right, center, _CMP_NGT_UQ));
+            }
+            unsigned bits = static_cast<unsigned>(_mm256_movemask_pd(matches));
+            while (bits) {
+                m_locations[found++] = i + __builtin_ctz(bits);
+                bits &= bits - 1U;
+            }
+        }
+        for (; i < end; ++i) atEdge(i);
+        return found;
+    }
+#endif
